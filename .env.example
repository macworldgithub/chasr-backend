# ─────────────────────────────────────────────
# Chasr Accounting Integration — Environment Variables
# Copy to .env and fill in real values before running.
# ─────────────────────────────────────────────

# ── Vault ─────────────────────────────────────
# Generate: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=

# ── Xero ──────────────────────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://app.chasr.com.au/integrations/xero/callback
XERO_WEBHOOK_SIGNING_SECRET=

# ── MYOB ──────────────────────────────────────
MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=
MYOB_REDIRECT_URI=https://app.chasr.com.au/integrations/myob/callback

# ── Redis (BullMQ + OAuth state cache) ────────
REDIS_URL=redis://localhost:6379

# ── MongoDB ───────────────────────────────────
MONGODB_URI=mongodb://chasr:chasr_dev_secret@localhost:27017/chasr?authSource=admin

# ── App ───────────────────────────────────────
APP_URL=https://app.chasr.com.au
PORT=3000
NODE_ENV=development

# ── Email (invite notifications) ──────────────
EMAIL_FROM=noreply@chasr.com.au
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── JWT (existing Chasr auth — must match api-server) ──
JWT_SECRET=

# ── CSV Upload ────────────────────────────────
CSV_MAX_FILE_SIZE_MB=25
CSV_TEMP_STORAGE_PATH=./tmp/chasr-csv

# ── Sync Defaults (overridden per-connection in DB) ──
DEFAULT_SYNC_FREQUENCY_MINUTES=30
DEFAULT_LOOKBACK_MONTHS=18
